# Copy to .env.local — never commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only — never exposed to client bundle
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_SERVER_ONLY

# Resend (email) — pay-as-you-go, no monthly minimum
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@yourdomain.com

# Telnyx (SMS/Voice) — pay-as-you-go
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=...
TELNYX_FROM_NUMBER=+1555...
TELNYX_APP_ID=...

# Test tenant credentials (only used by isolation test suite, not production)
TEST_TENANT_A_EMAIL=tenant-a@test.local
TEST_TENANT_A_PASSWORD=
TEST_TENANT_B_EMAIL=tenant-b@test.local
TEST_TENANT_B_PASSWORD=

# Gemini (AI — Phase 14C monthly report narration only)
# Get key at: https://aistudio.google.com/app/apikey
# If unset, report falls back to a plain data-only summary (no AI call).
GEMINI_API_KEY=

# Stripe Connect (tenant payment processing)
STRIPE_SECRET_KEY=sk_...
STRIPE_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Helcim Connect (tenant payment processing — paused, see memory)
HELCIM_API_KEY=
HELCIM_PARTNER_TOKEN=
HELCIM_CONNECT_VERIFIER_TOKEN=
HELCIM_WEBHOOK_SECRET=

# Google Calendar (tenant OAuth integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cal.com (tenant OAuth integration)
CAL_CLIENT_ID=
CAL_CLIENT_SECRET=
CAL_ENCRYPTION_KEY=
CAL_WEBHOOK_SECRET=

# ZAP vulnerability scan ingest (GitHub Actions -> this app)
ZAP_INGEST_SECRET=

# Provisioning script target URL
APP_URL=http://localhost:3011
